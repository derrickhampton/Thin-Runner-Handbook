THIN_RUNNER_ENV=local
THIN_RUNNER_LOG_LEVEL=INFO
THIN_RUNNER_MEMORY_PATH=memory/runs.jsonl
THIN_RUNNER_HUMAN_MEMORY_PATH=memory/memory.md

# Brave Search API (hello_world skill)
# Get your key at https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key-here
BRAVE_API_URL=https://api.search.brave.com/res/v1/news/search

# Ollama local inference (hello_world skill)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
